# ─────────────────────────────────────────────────────────────
# DRC CS 허브 작업기 설정 파일
# 이 파일을 복사해 같은 폴더에 ".env" 라는 이름으로 저장한 뒤 값을 채우세요.
# ".env" 파일은 절대 다른 사람에게 보내거나 채팅에 붙여넣지 마세요.
# ─────────────────────────────────────────────────────────────

# 작업기 이름 (PC가 여러 대일 때 구분용)
WORKER_ID=office-pc

# ▶ Supabase (Project Settings → API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# "secret" 키 (sb_secret_... 또는 service_role). 웹에는 절대 넣지 마세요.
SUPABASE_SECRET_KEY=

# ▶ 네이버 커머스API (커머스API센터 → 애플리케이션 → 애플리케이션 ID / 시크릿)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ▶ 쿠팡 Open API (Wing → 판매자정보 → 추가판매정보 → OPEN API 키 발급)
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 쿠팡 키 발급일 (만료 180일 알림용, 예: 2026-11-20)
COUPANG_KEY_ISSUED_AT=

# ▶ 공공데이터포털 특일정보 API 인증키 (선택 — 없으면 내장 공휴일 목록 사용)
DATA_GO_KR_SERVICE_KEY=

# ▶ 동작 설정
# 처음 실행할 때 며칠 전 문의부터 가져올지 (최대 30)
COLLECT_LOOKBACK_DAYS=7
# 실제 마켓 답변 등록 금지 (Phase 5 전까지 반드시 true)
DRY_RUN=true
