# ─────────────────────────────────────────────────────────────
# DRC CS 허브 설정 파일
# 이 파일을 복사해 같은 폴더에 ".env" 라는 이름으로 저장한 뒤 값을 채우세요.
# ".env" 파일은 절대 다른 사람에게 보내거나 채팅에 붙여넣지 마세요.
# ─────────────────────────────────────────────────────────────

# ▶ 네이버 커머스API (커머스API센터 → 애플리케이션 → 애플리케이션 ID / 시크릿)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ▶ 쿠팡 Open API (Wing → 판매자정보 → 추가판매정보 → OPEN API 키)
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 쿠팡 키 발급일 (만료 180일 경고용, 예: 2026-11-20)
COUPANG_KEY_ISSUED_AT=

# ▶ (선택) 공공데이터포털 특일정보 API 인증키 — 없으면 내장 공휴일 목록 사용
DATA_GO_KR_SERVICE_KEY=

# ▶ 알림 메일 보내는 계정 (네이버 메일 또는 Gmail)
#   네이버: 메일 → 환경설정 → POP3/IMAP 설정 → "IMAP/SMTP 사용" 켜기 + 2단계 인증 켠 뒤 "애플리케이션 비밀번호"를 만들어 넣기
#          (평소 비밀번호는 535 오류로 거부되는 경우가 많음). 비밀번호는 "큰따옴표"로 감싸기
#   Gmail: Google 계정 → 보안 → 2단계 인증 켠 뒤 "앱 비밀번호" 만들어 넣기
MAIL_USER=
MAIL_PASSWORD=
# (선택) 535 오류가 계속되면 MAIL_USER에 아이디만 넣고 여기에 전체 주소를 넣어보기
MAIL_FROM=
# 받는 사람은 허브 화면 [담당자] 메뉴에서 각자 이메일을 넣습니다.
# 메일 속 링크 주소 (비우면 이 PC의 사내망 주소를 자동 사용. 예: http://192.168.0.15:3000)
HUB_URL=

# ▶ (선택) 백업 폴더 — 비우면 worker-data\backups
#    예: 구글 드라이브 폴더  BACKUP_DIR=G:\내 드라이브\DRC-CS-백업
BACKUP_DIR=

# ▶ 동작 설정
# 화면 주소 포트 (http://PC주소:3000)
PORT=3000
# 처음 실행할 때 며칠 전 문의부터 가져올지 (최대 30)
COLLECT_LOOKBACK_DAYS=7
# 실제 마켓 답변 등록 금지 (Phase 5 전까지 반드시 true)
DRY_RUN=true
